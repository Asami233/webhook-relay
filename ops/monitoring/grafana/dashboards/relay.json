            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(hikaricp_connections_pending)",
          "legendFormat": "等待"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "GC 暂停（秒/秒）",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
