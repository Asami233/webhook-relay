# 复制为 .env（已被 .gitignore 忽略）并替换所有 change-me。
# compose.yaml 与 Spring Boot（spring.config.import）共用此文件；不要写行尾注释。

RELAY_DB_HOST=localhost
RELAY_DB_PORT=13306
RELAY_DB_NAME=relay
RELAY_DB_USER=relay
RELAY_DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

RELAY_REDIS_HOST=localhost
RELAY_REDIS_PORT=16379

# 管理接口口令，至少 16 字符
RELAY_ADMIN_TOKEN=change-me-to-a-long-random-string
# 端点 secret 的 AES-256 主密钥：openssl rand -base64 32
RELAY_MASTER_KEY=

# 本地演示：开启内置模拟接收方 /sink（生产按需）
RELAY_SINK_ENABLED=true

# 可选监控（docker compose --profile monitoring up -d）的 Grafana 管理员口令
GRAFANA_ADMIN_PASSWORD=change-me-grafana
